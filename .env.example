# API FastAPI. En local: http://localhost:8000
# Producción: https://fantasy-football-manager-api-production.up.railway.app
# Las rutas generadas por orval ya incluyen /api/v1.
VITE_API_BASE_URL=http://localhost:8000

# Supabase Auth (clave anon pública, nunca la service_role)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key

